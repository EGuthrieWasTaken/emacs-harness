#!/usr/bin/env python3
"""eh -- thin client for the emacs-harness control surface (DESIGN.md §6.1).

Does no work itself: builds a JSON request, ships it to `ehd` over the
configured transport, prints the response, and exits with a code the
caller can branch on without parsing prose.

  0 success    1 assertion/scenario failure    2 usage error
  3 timeout    4 Emacs signalled an error       5 session unreachable/dead

Transport is chosen by $EH_TRANSPORT (local|docker|ssh|http), default
"docker" outside a container / "local" when EH_SOCK is reachable directly.
See ~/.config/eh/config (INI-style: [eh] transport=..., host=...,
container=...) for a persistent default.

`http` (DESIGN §6.1, added in phase 4 for the MCP server -- see
mcp-server/) POSTs to `$EH_HOST/v1/<cmd>`, e.g. EH_HOST=https://emacs-
harness.example.com. Cloudflare Access service-token credentials, if the
harness's Access application is configured to require them, come from
$EH_CF_ACCESS_CLIENT_ID / $EH_CF_ACCESS_CLIENT_SECRET (or
cf_access_client_id / cf_access_client_secret in the config file).
"""
from __future__ import annotations

import argparse
import configparser
import json
import os
import socket
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

EXIT_USAGE = 2


def load_config() -> dict:
    cfg = {}
    path = Path(os.environ.get("EH_CONFIG", str(Path.home() / ".config" / "eh" / "config")))
    if path.exists():
        parser = configparser.ConfigParser()
        parser.read(path)
        if parser.has_section("eh"):
            cfg.update(parser["eh"])
    return cfg


def transport_settings():
    cfg = load_config()
    transport = os.environ.get("EH_TRANSPORT", cfg.get("transport", "docker"))
    host = os.environ.get("EH_HOST", cfg.get("host", ""))
    container = os.environ.get("EH_CONTAINER", cfg.get("container", "emacs-harness"))
    sock = os.environ.get("EH_SOCK", cfg.get("sock", "/run/eh/eh.sock"))
    return transport, host, container, sock


def _http_credentials(cfg: dict) -> tuple[str, str]:
    client_id = os.environ.get("EH_CF_ACCESS_CLIENT_ID", cfg.get("cf_access_client_id", ""))
    client_secret = os.environ.get("EH_CF_ACCESS_CLIENT_SECRET", cfg.get("cf_access_client_secret", ""))
    return client_id, client_secret


def send_http_request(req: dict, host: str, timeout: float) -> dict:
    if not host:
        return {"ok": False,
                "error": {"message": "EH_TRANSPORT=http requires EH_HOST "
                                      "(the harness's https:// base URL)"},
                "exit_code": EXIT_USAGE}
    body = json.dumps({"session": req.get("session"), "args": req.get("args") or {},
                        "timeout": req.get("timeout")}).encode()
    url = f"{host.rstrip('/')}/v1/{req['cmd']}"
    headers = {"Content-Type": "application/json"}
    client_id, client_secret = _http_credentials(load_config())
    if client_id:
        headers["CF-Access-Client-Id"] = client_id
    if client_secret:
        headers["CF-Access-Client-Secret"] = client_secret
    http_req = urllib.request.Request(url, data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(http_req, timeout=timeout + 10) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read().decode())
        except Exception:
            return {"ok": False, "error": {"message": f"http {e.code}: {e.reason}"},
                    "exit_code": 5}
    except urllib.error.URLError as e:
        return {"ok": False, "error": {"message": f"cannot reach ehd (http, {url}): {e.reason}"},
                "exit_code": 5}
    except Exception as e:  # noqa: BLE001
        return {"ok": False, "error": {"message": f"http transport error: {e}"}, "exit_code": 5}


def send_request(req: dict, timeout: float) -> dict:
    transport, host, container, sock_path = transport_settings()
    line = (json.dumps(req) + "\n").encode()

    if transport == "http":
        return send_http_request(req, host, timeout)

    if transport == "local":
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.settimeout(timeout + 10)
            s.connect(sock_path)
            s.sendall(line)
            chunks = []
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                chunks.append(chunk)
                if chunk.endswith(b"\n"):
                    break
            return json.loads(b"".join(chunks).decode())
        except OSError as e:
            return {"ok": False, "error": {"message": f"cannot reach ehd (local, {sock_path}): {e}"},
                    "exit_code": 5}
        finally:
            s.close()

    if transport == "docker":
        argv = ["docker", "exec", "-i", container, "ehd-cli"]
    elif transport == "ssh":
        if not host:
            return {"ok": False, "error": {"message": "EH_TRANSPORT=ssh requires EH_HOST"},
                    "exit_code": EXIT_USAGE}
        argv = ["ssh", host, "--", "docker", "exec", "-i", container, "ehd-cli"]
    else:
        return {"ok": False, "error": {"message": f"unknown transport: {transport}"},
                "exit_code": EXIT_USAGE}

    try:
        proc = subprocess.run(argv, input=line, capture_output=True, timeout=timeout + 15)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": {"message": "transport timed out"}, "exit_code": 3}
    if not proc.stdout:
        return {"ok": False, "error": {"message": proc.stderr.decode(errors="replace") or
                                        "no response from ehd"}, "exit_code": 5}
    try:
        return json.loads(proc.stdout.decode().strip().splitlines()[-1])
    except Exception:
        return {"ok": False, "error": {"message": proc.stdout.decode(errors="replace")},
                "exit_code": 5}


def parse_region(vals):
    if not vals:
        return None
    return [int(vals[0]), int(vals[1])]


# Per-command timeout defaults, in seconds. `run' is the outlier and the
# reason this table exists: it is the one command whose duration is a
# whole test suite's, not one round trip's, and inheriting the 30s eval
# default silently capped it. A profile of any size then died with
# "cannot reach ehd: timed out" while the run was still going perfectly
# well on the other side -- which reads as a broken harness rather than
# as a timeout, and leaves the run's own artifacts behind unexplained.
# `eh run smoke' fits in 30s, which is exactly why this went unnoticed.
DEFAULT_TIMEOUTS = {"run": 1800, "video": 300}
DEFAULT_TIMEOUT = 30


def resolve_timeout(args) -> float:
    """The timeout for this invocation: explicit --timeout, else the
    command's own default."""
    if getattr(args, "timeout", None) is not None:
        return args.timeout
    return DEFAULT_TIMEOUTS.get(args.command, DEFAULT_TIMEOUT)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="eh")
    p.add_argument("--session", default=None)
    # Deliberately no default here: 30s is right for a single eval and
    # absurd for a whole suite, so the default is resolved per command in
    # `resolve_timeout' below. An explicit --timeout still wins everywhere.
    p.add_argument("--timeout", type=float, default=None)
    p.add_argument("--json", action="store_true")
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("doctor")

    sess = sub.add_parser("session")
    sess_sub = sess.add_subparsers(dest="action", required=True)
    sn = sess_sub.add_parser("new")
    sn.add_argument("--name", required=True)
    sn.add_argument("--profile", default="smoke")
    sn.add_argument("--geometry", default="1280x800")
    sn.add_argument("--theme", default=None)
    sn.add_argument("--emacs", default=None)
    sess_sub.add_parser("list")
    sr = sess_sub.add_parser("reset")
    sr.add_argument("--name", default=None)
    srm = sess_sub.add_parser("rm")
    srm.add_argument("--name", default=None)

    ev = sub.add_parser("eval")
    ev.add_argument("form")
    ev.add_argument("--out", default=None)

    sn2 = sub.add_parser("snapshot")
    sn2.add_argument("--buffer", default=None)
    sn2.add_argument("--window", action="store_true")
    sn2.add_argument("--region", nargs=2, metavar=("BEG", "END"))
    sn2.add_argument("--props", default=None)
    sn2.add_argument("--visible-only", action="store_true")
    sn2.add_argument("--no-text", action="store_true")
    sn2.add_argument("--images", action="store_true")
    sn2.add_argument("--format", choices=["sexp", "json"], default="json")

    sub.add_parser("describe")

    kk = sub.add_parser("keys")
    kk.add_argument("keys", nargs="+")
    kk.add_argument("--x", action="store_true")

    tt = sub.add_parser("type")
    tt.add_argument("text")

    ck = sub.add_parser("click")
    g = ck.add_mutually_exclusive_group()
    g.add_argument("--at-point", action="store_true")
    g.add_argument("--at", default=None)
    g.add_argument("--at-text", default=None)
    g.add_argument("--xy", default=None)
    ck.add_argument("--button", type=int, default=1)
    ck.add_argument("--double", action="store_true")
    ck.add_argument("--modifiers", default=None, help="comma-separated: ctrl,shift,alt,super,hyper")

    dr = sub.add_parser("drag")
    dr.add_argument("--from", dest="from_", required=True)
    dr.add_argument("--to", required=True)

    sc = sub.add_parser("scroll")
    scg = sc.add_mutually_exclusive_group(required=True)
    scg.add_argument("--lines", type=int)
    scg.add_argument("--pixels", type=int)

    an = sub.add_parser("answer")
    an.add_argument("value")

    wt = sub.add_parser("wait")
    wt.add_argument("what")
    wt.add_argument("--timeout", type=float, default=30)
    wt.add_argument("--poll", type=float, default=50)

    se = sub.add_parser("settle")
    se.add_argument("--frames-stable", type=int, default=2)
    se.add_argument("--timeout", type=float, default=5)

    sh = sub.add_parser("shot")
    sh.add_argument("--out", default=None)
    mode = sh.add_mutually_exclusive_group()
    mode.add_argument("--frame", action="store_true")
    mode.add_argument("--display", action="store_true")

    vd = sub.add_parser("video")
    vd_sub = vd.add_subparsers(dest="action", required=True)
    vs = vd_sub.add_parser("start")
    vs.add_argument("--out", default=None)
    vstop = vd_sub.add_parser("stop")
    vstop.add_argument("--gif", action="store_true")

    ds = sub.add_parser("diff-shot")
    ds.add_argument("name")
    ds.add_argument("--tolerance", type=float, default=0.002)

    ba = sub.add_parser("baseline")
    ba_sub = ba.add_subparsers(dest="action", required=True)
    baa = ba_sub.add_parser("accept")
    baa.add_argument("name", nargs="?")
    baa.add_argument("--all", action="store_true")

    rn = sub.add_parser("run")
    rn.add_argument("profile")
    rn.add_argument("--scenario", action="append", default=[])
    rn.add_argument("--tag", default=None)
    rn.add_argument("--emacs", default=None, help="comma-separated Emacs binaries/versions to run the matrix over")
    rn.add_argument("--batch", action="store_true")
    rn.add_argument("--reuse-session", action="store_true")
    rn.add_argument("--junit", default=None)

    lg = sub.add_parser("logs")
    lg.add_argument("--service", default="emacs")
    lg.add_argument("--tail", type=int, default=100)

    return p


def to_request(args) -> dict:
    cmd = args.command
    a = {}
    if cmd == "session":
        cmd = f"session-{args.action}"
        if args.action == "new":
            a = dict(name=args.name, profile=args.profile, geometry=args.geometry,
                      theme=args.theme, emacs=args.emacs)
        else:
            a = dict(name=getattr(args, "name", None))
    elif cmd == "eval":
        a = dict(form=args.form)
    elif cmd == "snapshot":
        a = dict(buffer=args.buffer, window=args.window, region=parse_region(args.region),
                  props=args.props.split(",") if args.props else None,
                  visible_only=args.visible_only, no_text=args.no_text, images=args.images,
                  format=args.format)
    elif cmd == "keys":
        a = dict(keys=args.keys, x=args.x)
    elif cmd == "type":
        a = dict(text=args.text)
    elif cmd == "click":
        a = dict(at_point=args.at_point, at=args.at, at_text=args.at_text,
                  xy=[int(v) for v in args.xy.split(",")] if args.xy else None,
                  button=args.button, double=args.double,
                  modifiers=args.modifiers.split(",") if args.modifiers else None)
    elif cmd == "drag":
        a = dict(**{"from": args.from_}, to=args.to)
    elif cmd == "scroll":
        a = dict(lines=args.lines, pixels=args.pixels)
    elif cmd == "answer":
        a = dict(value=args.value)
    elif cmd == "wait":
        a = dict(what=args.what, is_name=not args.what.strip().startswith("("),
                  timeout=args.timeout, poll_ms=args.poll)
    elif cmd == "settle":
        a = dict(frames_stable=args.frames_stable, timeout=args.timeout)
    elif cmd == "shot":
        a = dict(out=args.out, display=args.display)
    elif cmd == "video":
        cmd = f"video-{args.action}"
        a = dict(out=getattr(args, "out", None), gif=getattr(args, "gif", False))
    elif cmd == "diff-shot":
        a = dict(name=args.name, tolerance=args.tolerance)
    elif cmd == "baseline":
        cmd = f"baseline-{args.action}"
        if args.action == "accept" and not args.name and not args.all:
            print("eh baseline accept: need NAME or --all", file=sys.stderr)
            sys.exit(EXIT_USAGE)
        a = dict(name=args.name, all=args.all)
    elif cmd == "run":
        a = dict(profile=args.profile, scenario=args.scenario, tag=args.tag,
                  emacs=args.emacs.split(",") if args.emacs else None,
                  batch=args.batch, reuse_session=args.reuse_session)
    elif cmd == "logs":
        a = dict(service=args.service, tail=args.tail)
        # profile is a positional arg on `eh run`; ehd's session must already
        # target that profile (`eh session new --profile ...`), so fold it
        # into the session name convention when the caller didn't pass one.
    return dict(cmd=cmd, session=args.session, args=a,
                timeout=resolve_timeout(args))


def render(args, resp: dict) -> None:
    as_json = args.json or not sys.stdout.isatty()
    if as_json:
        print(json.dumps(resp, indent=2 if sys.stdout.isatty() else None))
        return

    cmd = args.command
    if cmd == "doctor":
        for c in resp.get("checks", []):
            mark = "OK  " if c["ok"] else "FAIL"
            print(f"[{mark}] {c['check']:<32} {c.get('detail', '')}")
        print("ALL GREEN" if resp.get("ok") else "DOCTOR FOUND PROBLEMS")
    elif cmd == "run":
        if "matrix" in resp:
            for version, r in resp["matrix"].items():
                label = version or "default"
                summary = r.get("summary", {})
                for t in summary.get("tests", []):
                    print(f"[{label}] {t['status'].upper():8s} {t['name']}")
                verdict = "OK" if r.get("ok") else "FAIL"
                print(f"[{label}] {verdict}"
                      + (f" -- {r['error'].get('message', '')}" if r.get("error") else ""))
                if "run_dir" in r:
                    print(f"[{label}] {r['run_dir']}")
        else:
            summary = resp.get("summary", {})
            for t in summary.get("tests", []):
                print(f"{t['status'].upper():8s} {t['name']}")
            if "run_dir" in resp:
                print(resp["run_dir"])
    elif cmd == "eval":
        if "value" in resp:
            print(resp["value"])
        elif "value_file" in resp:
            print(resp["value_file"])
        if resp.get("error"):
            print(resp["error"].get("message", ""), file=sys.stderr)
    elif cmd == "snapshot":
        print(json.dumps(resp.get("snapshot"), indent=2))
    elif cmd == "describe":
        print(json.dumps(resp.get("describe"), indent=2))
    elif cmd == "logs":
        for line in resp.get("lines", []):
            print(line)
    else:
        print(json.dumps(resp, indent=2))

    if not resp.get("ok") and resp.get("error"):
        print(f"error: {resp['error'].get('message', resp['error'])}", file=sys.stderr)


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    req = to_request(args)
    resp = send_request(req, resolve_timeout(args))
    render(args, resp)
    return int(resp.get("exit_code", 0 if resp.get("ok") else 1))


if __name__ == "__main__":
    sys.exit(main())
